<Project>
	<!--
	  Central package versions for every project in the repository.
	  A project references a package with <PackageReference Include="X" />
	  (no Version); the version comes from the PackageVersion below.
	  To use a different version in one project, set VersionOverride on
	  that project's PackageReference.

	  The project inside templates/ is shipped as the content of the
	  `dotnet new` template and has to build on its own after a user
	  creates it, so it keeps its own versions and is left out here.
	-->
	<PropertyGroup>
		<ManagePackageVersionsCentrally Condition="!$(MSBuildProjectDirectory.Replace('\', '/').Contains('/templates/'))">true</ManagePackageVersionsCentrally>
	</PropertyGroup>

	<!-- Libraries and applications -->
	<ItemGroup>
		<PackageVersion Include="IronPython" Version="3.4.2" />
		<PackageVersion Include="Microsoft.Extensions.Hosting" Version="7.0.0" />
		<PackageVersion Include="Microsoft.SourceLink.GitHub" Version="1.1.1" />
		<PackageVersion Include="MQTTnet" Version="4.3.7.1207" />
		<PackageVersion Include="NLog" Version="5.2.7" />
		<PackageVersion Include="System.Buffers" Version="4.5.1" />
		<PackageVersion Include="System.Configuration.ConfigurationManager" Version="8.0.0" />
		<PackageVersion Include="System.IO.Ports" Version="8.0.0" />
		<PackageVersion Include="System.Runtime.InteropServices.RuntimeInformation" Version="4.3.0" />
		<PackageVersion Include="System.ServiceProcess.ServiceController" Version="7.0.0" />
		<PackageVersion Include="System.Text.Json" Version="8.0.5" />
		<PackageVersion Include="YamlDotNet" Version="13.7.1" />
	</ItemGroup>

	<!-- Build tools -->
	<ItemGroup>
		<PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.11.0" />
		<PackageVersion Include="Scriban" Version="7.2.2" />
	</ItemGroup>

	<!-- Tests -->
	<ItemGroup>
		<PackageVersion Include="coverlet.collector" Version="6.0.4" />
		<PackageVersion Include="DeepEqual" Version="4.2.1" />
		<PackageVersion Include="Divergic.Logging.Xunit" Version="4.2.0" />
		<PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
		<PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
		<PackageVersion Include="NUnit" Version="3.14.0" />
		<PackageVersion Include="NUnit3TestAdapter" Version="4.6.0" />
		<PackageVersion Include="Testcontainers" Version="3.10.0" />
		<PackageVersion Include="xunit" Version="2.9.2" />
		<PackageVersion Include="xunit.runner.visualstudio" Version="2.4.5" />
	</ItemGroup>
</Project>
