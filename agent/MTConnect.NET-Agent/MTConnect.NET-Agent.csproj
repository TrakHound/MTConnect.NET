<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup Condition="'$(Configuration)'=='Debug'">
		<TargetFrameworks>net8.0</TargetFrameworks>
		<DebugType>full</DebugType>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)'=='Release'">
		<TargetFrameworks>net461;net48;net6.0;net7.0;net8.0;net9.0;net10.0</TargetFrameworks>
		<DebugSymbols>false</DebugSymbols>
		<DebugType>None</DebugType>
		<Optimize>true</Optimize>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)'=='Docker'">
		<TargetFrameworks>net461;net462;net47;net471;net472;net48;net6.0;net7.0;net8.0;net9.0;net10.0</TargetFrameworks>
	</PropertyGroup>

	<PropertyGroup>
		<Configurations>Debug;Release;Docker</Configurations>
		<AssemblyName>agent</AssemblyName>
		<Product>MTConnect.NET Agent</Product>
		<Description>.NET MTConnect Agent for Data Collection</Description>
		<OutputType>Exe</OutputType>
		<RootNamespace>MTConnect</RootNamespace>
		<StartupObject>MTConnect.Applications.Program</StartupObject>
		<Nullable>disable</Nullable>
	</PropertyGroup>

	<ItemGroup>
	  <None Remove="NLog.config" />
	</ItemGroup>

	<ItemGroup>
	  <Content Include="NLog.config">
	    <PackagePath>contentFiles\any\any;content</PackagePath>
	    <CopyToOutputDirectory>Always</CopyToOutputDirectory>
	    <IncludeInPackage>true</IncludeInPackage>
	    <PackageCopyToOutput>true</PackageCopyToOutput>
	    <CopyToOutput>true</CopyToOutput>
	    <Pack>True</Pack>
	  </Content>
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\MTConnect.NET-Applications-Agents\MTConnect.NET-Applications-Agents.csproj" />
	</ItemGroup>

	<!--
	  The built-in modules, referenced directly so BuiltInRegistrations.cs can
	  register them by type. Most of them are named MTConnect.Modules.Module,
	  so each gets an extern alias to tell them apart.
	-->
	<ItemGroup>
	  <ProjectReference Include="..\Modules\MTConnect.NET-AgentModule-FanucAdapter\MTConnect.NET-AgentModule-FanucAdapter.csproj" Aliases="FanucAdapter" />
	  <ProjectReference Include="..\Modules\MTConnect.NET-AgentModule-HaasAdapter\MTConnect.NET-AgentModule-HaasAdapter.csproj" Aliases="HaasAdapter" />
	  <ProjectReference Include="..\Modules\MTConnect.NET-AgentModule-HttpAdapter\MTConnect.NET-AgentModule-HttpAdapter.csproj" Aliases="HttpAdapter" />
	  <ProjectReference Include="..\Modules\MTConnect.NET-AgentModule-HttpServer\MTConnect.NET-AgentModule-HttpServer.csproj" Aliases="HttpServer" />
	  <ProjectReference Include="..\Modules\MTConnect.NET-AgentModule-MqttAdapter\MTConnect.NET-AgentModule-MqttAdapter.csproj" Aliases="MqttAdapter" />
	  <ProjectReference Include="..\Modules\MTConnect.NET-AgentModule-MqttBroker\MTConnect.NET-AgentModule-MqttBroker.csproj" Aliases="MqttBroker" />
	  <ProjectReference Include="..\Modules\MTConnect.NET-AgentModule-MqttRelay\MTConnect.NET-AgentModule-MqttRelay.csproj" Aliases="MqttRelay" />
	  <ProjectReference Include="..\Modules\MTConnect.NET-AgentModule-ShdrAdapter\MTConnect.NET-AgentModule-ShdrAdapter.csproj" Aliases="ShdrAdapter" />
	  <ProjectReference Include="..\Modules\MTConnect.NET-AgentModule-TormachAdapter\MTConnect.NET-AgentModule-TormachAdapter.csproj" Aliases="TormachAdapter" />
	  <ProjectReference Include="..\Modules\MTConnect.NET-AgentModule-WebUI\MTConnect.NET-AgentModule-WebUI.csproj" Aliases="WebUI" />
	</ItemGroup>

	<ItemGroup>
		<None Update="agent.config.yaml">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
		<None Update="devices\mazak.xml">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
		<None Update="devices\okuma.xml">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
		<None Update="README.md">
			<PackagePath>\</PackagePath>
			<Pack>True</Pack>
		</None>
	</ItemGroup>

</Project>
