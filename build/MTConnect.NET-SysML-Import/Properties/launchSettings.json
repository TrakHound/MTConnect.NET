{
  "$schema": "https://json.schemastore.org/launchsettings.json",
  "profiles": {
    "Import (env vars)": {
      "commandName": "Project",
      "commandLineArgs": "--xmi \"%MTCONNECT_XMI_PATH%\" --output \"%MTCONNECT_NET_REPO%\""
    },
    "Import (sysml-model submodule)": {
      "commandName": "Project",
      "commandLineArgs": "--xmi ../sysml-model/MTConnectSysMLModel.xml --output ../..",
      "workingDirectory": "$(ProjectDir)",
      "comment": "Uses the mtconnect/mtconnect_sysml_model submodule at build/sysml-model. Switch standard version with `git -C build/sysml-model checkout v2.7` (or v2.6 / v2.5) from the repo root."
    },
    "Import (json-dump enabled, sysml-model submodule)": {
      "commandName": "Project",
      "commandLineArgs": "--xmi ../sysml-model/MTConnectSysMLModel.xml --output ../.. --json-dump ../../.cache/mtconnect-model.json",
      "workingDirectory": "$(ProjectDir)"
    }
  }
}
