<?xml version="1.0" encoding="utf-8"?>
<!--
  Package sources for this repository. Every package the repository uses
  comes from nuget.org, so machine-level feeds are cleared to keep restores
  the same on every machine. Central package management (see
  Directory.Packages.props) also requires each package to map to one source.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
